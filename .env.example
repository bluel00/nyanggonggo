# 공공데이터포털 서비스키. "디코딩된 키(Decoding)" 값을 그대로 넣는다.
# 인코딩은 서버 코드의 URLSearchParams가 한 번만 한다. 인코딩된 키를 넣으면 이중 인코딩된다.
# 서버 전용이다. NEXT_PUBLIC_ 접두어를 붙이지 않는다.
DATA_GO_KR_SERVICE_KEY=

# 카카오 JavaScript 키. 카카오 개발자 콘솔에서 사이트 도메인을 제한하는 공개 키라 NEXT_PUBLIC_이 맞다.
# 비워 두면 카카오톡 공유 대신 링크 복사로 동작한다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 공유 링크의 기준 주소(예: https://example.com). 비워 두면 접속한 주소를 쓴다.
# 로컬에서 카카오 공유를 시험할 때만 배포 도메인을 넣는다(localhost 링크는 폰에서 열 수 없어 공유가 링크 복사로 폴백된다).
# 여기에 넣는 도메인은 카카오 개발자 콘솔 [플랫폼 > Web 사이트 도메인]에도 등록되어 있어야 카드의 링크가 동작한다.
NEXT_PUBLIC_SITE_URL=
