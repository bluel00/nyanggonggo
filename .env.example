# 공공데이터포털 서비스키. "디코딩된 키(Decoding)" 값을 그대로 넣는다.
# 인코딩은 서버 코드의 URLSearchParams가 한 번만 한다. 인코딩된 키를 넣으면 이중 인코딩된다.
# 서버 전용이다. NEXT_PUBLIC_ 접두어를 붙이지 않는다.
DATA_GO_KR_SERVICE_KEY=

# 카카오 JavaScript 키. 카카오 개발자 콘솔에서 사이트 도메인을 제한하는 공개 키라 NEXT_PUBLIC_이 맞다.
# 비워 두면 카카오톡 공유 대신 링크 복사로 동작한다.
NEXT_PUBLIC_KAKAO_JS_KEY=
