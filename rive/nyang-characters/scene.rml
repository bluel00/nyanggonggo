        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Character" id="0:8">
                <!-- press는 어느 상태에서든 받는다(greet 중에도, 나중에 넣을 sleep 중에도) -->
                <AnyState x="200" y="-160">
                    <StateTransition stateToId="0:14">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:50-0:52" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="600" y="-160"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <!-- greet: 들어올 때 1회 → 끝나면 idle -->
                <AnimationState x="200" y="0" animationId="0:20" stateName="greet" id="0:12">
                    <StateTransition stateToId="0:13" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <!-- idle: 평소. sleep(약 10초 입력 없음 → 꾸벅 → 엎드림)은 엎드린 포즈 그림이 나오면 여기서 나가는 전환으로 붙인다 -->
                <AnimationState x="400" y="0" animationId="0:21" stateName="idle" id="0:13"/>
                <!-- press: 250ms 반응 → idle -->
                <AnimationState x="400" y="-160" animationId="0:22" reset="true" stateName="press" id="0:14">
                    <StateTransition stateToId="0:13" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

