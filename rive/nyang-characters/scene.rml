        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Character" id="0:8">
                <AnyState x="200" y="-160"/>
                <ExitState x="800" y="-160"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <!-- greet: 들어올 때 1회(엉덩이 씰룩 → 덮치기) → idle. 누르면 끊고 press -->
                <AnimationState x="200" y="0" animationId="0:20" stateName="greet" id="0:12">
                    <StateTransition stateToId="0:13" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="0:14">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:50-0:52" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <!-- idle: 무입력 10초(exitTime ms)면 sleepEnter. 다시 들어올 때마다 처음부터(reset) -->
                <AnimationState x="400" y="0" animationId="0:21" reset="true" stateName="idle" id="0:13">
                    <StateTransition stateToId="0:15" enableExitTime="true" exitTime="10000"/>
                    <StateTransition stateToId="0:14">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:50-0:52" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <!-- press: 250ms → idle -->
                <AnimationState x="400" y="-160" animationId="0:22" reset="true" stateName="press" id="0:14">
                    <StateTransition stateToId="0:13" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <!-- sleep: 졸기 → 눕기 → 잠(반복). 누르면 wake(정면 앉음으로 튀어 오름) -->
                <AnimationState x="600" y="0" animationId="0:23" reset="true" stateName="sleepEnter" id="0:15">
                    <StateTransition stateToId="0:16" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                    <StateTransition stateToId="0:17">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:50-0:52" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="800" y="0" animationId="0:24" stateName="sleep" id="0:16">
                    <StateTransition stateToId="0:17">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:50-0:52" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="600" y="-160" animationId="0:25" reset="true" stateName="wake" id="0:17">
                    <StateTransition stateToId="0:13" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

